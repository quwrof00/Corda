generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String   @db.Citext
  email         String   @unique
  emailVerified DateTime?
  password      String
  image         String?

  skills        String[]
  workload      Int      @default(0)
  role          String?
  resumeUrl     String?
  wallpaperUrl  String?
  autoDeleteStaleTasks Boolean @default(false)

  teams         Team[]   @relation("TeamMembers")

  // 🔹 Opposite side of Team.leader
  leadingTeams  Team[]   @relation("TeamLeader")

  // 🔹 Opposite side of Task.assignedTo
  assignedTasks Task[]

  accounts      Account[]
  sessions      Session[]
  moodleIntegration MoodleIntegration?
}

model Team {
  id        String   @id @default(cuid())
  name      String
  desc      String?
  members   User[]   @relation("TeamMembers")

  // 🔹 Leader relationship
  leaderId String?
  leader   User?    @relation("TeamLeader", fields: [leaderId], references: [id])

  // 🔹 One team has many tasks
  tasks    Task[]
  invites  Invite[]
  enableAll Boolean @default(false)

  // 🔹 Team-wide scratchpad for collaborative notes
  scratchpad String?  @db.Text
}

model Invite {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email      String
  role       String    @default("member")
  tokenHash  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([teamId, email])
}

model Task {
  id            String   @id @default(cuid())
  title         String
  desc          String?
  deadline      DateTime
  requiredSkill String?
  priority      String
  status        String

  recurrenceId  String?
  recurrence    Recurrence? @relation(fields: [recurrenceId], references: [id])

  teamId  String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])
  
  parentId String?
  parent   Task?   @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[]  @relation("SubTasks")

  source      String   @default("manual") // "manual", "moodle"
  externalId  String?  // UID from ICS

  @@unique([externalId, assignedToId]) // Ensure unique task mapping per user (if assigned)
  @@index([parentId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recurrence {
  id           String   @id @default(cuid())
  frequency    String   // "daily", "weekly", "monthly"
  interval     Int      // every X days/weeks/months
  daysOfWeek   Int[]    // for weekly (0=Sunday, 1=Monday, etc.)
  dayOfMonth   Int?     // for monthly (1-31)
  endDate      DateTime?
  nextRunAt    DateTime
  
  // Relation to tasks
  tasks        Task[]
  
  createdAt    DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MoodleIntegration {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  icsUrl             String
  lastSyncedAt       DateTime?
  lastSyncHash       String?
  isActive           Boolean   @default(true)
  syncFrequencyHours Int       @default(6)
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
